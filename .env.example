# Authorize.net credentials
AUTHORIZE_ENVIRONMENT=sandbox
AUTHORIZE_API_LOGIN_ID=your_api_login_id
AUTHORIZE_TRANSACTION_KEY=your_transaction_key
AUTHORIZE_SIGNATURE_KEY=your_signature_key
AUTHORIZE_WEBHOOK_DEBUG=false
CHECKOUT_ENABLED=true

# Site base URL fallback when request origin is unavailable
SITE_URL=https://your-domain.com

# Redis / KV connection
REDIS_URL=redis://default:password@host:port
# STORAGE_URL=redis://default:password@host:port

# Automatic Illinois ZIP tax sync source (JSON map or CSV: zip,rate)
IL_ZIP_TAX_SOURCE_URL=https://example.com/il-zip-tax-rates.json
IL_TAX_SYNC_TOKEN=replace_with_secure_random_token
