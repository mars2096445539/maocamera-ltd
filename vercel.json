      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cart",
      "destination": "/pages/cart.html"
    },
    {
      "source": "/checkout-embedded",
      "destination": "/pages/checkout-embedded.html"
    },
    {
      "source": "/equipment-rental",
      "destination": "/pages/equipment-rental.html"
    },
    {
      "source": "/film-development",
      "destination": "/pages/film-development.html"
    },
    {
      "source": "/iframe-communicator",
      "destination": "/pages/iframe-communicator.html"
    },
    {
      "source": "/photography-services",
      "destination": "/pages/photography-services.html"
    },
    {
      "source": "/product-detail",
      "destination": "/pages/product-detail.html"
    },
    {
      "source": "/store",
      "destination": "/pages/store.html"
    },
    {
      "source": "/studio-darkroom-rental",
      "destination": "/pages/studio-darkroom-rental.html"
    },
    {
      "source": "/success",
      "destination": "/pages/success.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.authorize.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://accept.authorize.net https://test.authorize.net; frame-src https://accept.authorize.net https://test.authorize.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://accept.authorize.net https://test.authorize.net"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-il-tax-rates",
      "schedule": "0 7 * * *"
    }
  ]
}
